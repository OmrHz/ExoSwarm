# Optional. Without a key ExoSwarm uses its explicit, trace-recorded safe policy fallback.
EXOSWARM_PROVIDER=featherless
EXOSWARM_API_KEY=
EXOSWARM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EXOSWARM_API_BASE=https://api.featherless.ai/v1

EXOSWARM_DATA_DIR=data
EXOSWARM_RUNS_DIR=runs
EXOSWARM_MAX_AGENT_TURNS=4
EXOSWARM_EXPERIMENT_BUDGET=14
EXOSWARM_REQUEST_TIMEOUT_SECONDS=45
